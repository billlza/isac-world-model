include README.md RIGHTS.md CHANGELOG.md AGENTS.md Cargo.toml Cargo.lock rust-toolchain.toml
recursive-include crates *.toml *.rs
recursive-include scripts *.py *.sh
recursive-include ci *.txt *.json *.lock
recursive-include tests *.py
recursive-include docs *.md
recursive-include .github *.yml
prune runs
prune checkpoints
prune target
prune validation
include .python-version uv.lock
